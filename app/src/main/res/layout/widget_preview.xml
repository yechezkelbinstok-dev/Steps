<?xml version="1.0" encoding="utf-8"?>
<!-- Shown in the widget picker (Android 12+). Mirrors the 4×2 layout in StepsWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:backgroundTint="@color/widget_bg"
    android:baselineAligned="false"
    android:foreground="@drawable/widget_sheen"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:ignore="UselessParent">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/ring_glow"
                android:tint="@color/widget_accent" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/ring_track"
                android:tint="@color/widget_track" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/ring_p084"
                android:tint="@color/widget_accent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_steps"
                    android:tint="@color/widget_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="google-sans"
                    android:text="@string/preview_steps"
                    android:textColor="@color/widget_text"
                    android:textSize="27sp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/WidgetPreviewMetric"
            android:drawableStart="@drawable/ic_fire"
            android:drawableTint="@color/widget_accent"
            android:text="@string/preview_calories" />

        <TextView
            style="@style/WidgetPreviewMetric"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_distance"
            android:drawableTint="@color/widget_accent"
            android:text="@string/preview_distance" />

    </LinearLayout>
</LinearLayout>
